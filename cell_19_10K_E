QUERY_KG = "What are some common meanings of the acronym AWS mentioned in this document?"

print(f"\n[Cell 19 using query]: {QUERY_KG}")

chosen = retrieve_chunks(QUERY_KG, top_k=TOP_K, verbose=True)

