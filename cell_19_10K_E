# ==========================================================
# Cell 19 : Graph-Scoped BM25 Retriever (chunks) — NO LLM
#           Query -> BM25 seeds -> BFS hops -> scope -> BM25 ranks
#           chunks within scope. Returns top-K:
#               {content, title, reference}
#           Output var: response_kg
# ==========================================================
import re, math, json, hashlib
from collections import Counter, defaultdict

print("=" * 80)
print("CELL 19 — GRAPH-SCOPED BM25 CHUNK RETRIEVER (no LLM)")
print("=" * 80)

TOP_K, N_SEEDS, MAX_HOP = 10, 5, 2
CHUNK_SIZE, CHUNK_STRIDE, MIN_CHUNK, MAX_PER_DOC = 900, 700, 120, 5
JACCARD, SHINGLE_N = 0.25, 5

QUERY_KG = "What steps should be taken if an Engineering Supplier Integration Document (ESID) is not already available for a supplier?"
print(f"[Cell 19 using query]: {QUERY_KG}\n")


def toks(t):
    return re.findall(r"[a-z0-9]+", str(t).lower())


def tset(t):
    return set(toks(t))


def shingles(t, n=SHINGLE_N):
    w = toks(t)
    return {" ".join(w[i:i + n]) for i in range(max(0, len(w) - n + 1))}


# Unresolved links keep raw markup like "[<doc:wiki:...WebHome>]".
# That is machine noise, not document text -- strip before chunking.
_MARKUP = re.compile(r"\[?<doc:(?:wiki:)?[^<>]+>\]?")


def clean(t):
    return re.sub(r"\s+", " ", _MARKUP.sub(" ", str(t or ""))).strip()


def split_chunks(text):
    """Sentence-boundary packing with a stride. CHUNK_STRIDE < CHUNK_SIZE
    gives controlled overlap so a fact spanning a boundary survives whole
    in at least one chunk -- the near-duplicate filter below removes the
    redundancy this creates, rather than paying for it in the payload."""
    text = clean(text)
    units = [u.strip() for u in re.split(r"(?<=[.!?])\s+|\n+", text) if u.strip()]
    if not units:
        return []

    out, i = [], 0
    while i < len(units):
        buf, j = "", i
        while j < len(units) and len(buf) + len(units[j]) + 1 <= CHUNK_SIZE:
            buf = (buf + " " + units[j]).strip()
            j += 1
        if j == i:                        # single oversized unit
            out.append(units[i][:CHUNK_SIZE])
            i += 1
            continue
        if len(buf) >= MIN_CHUNK:
            out.append(buf)
        adv, k = 0, i
        while k < j and adv < CHUNK_STRIDE:
            adv += len(units[k]) + 1
            k += 1
        i = max(k, i + 1)
    return out


# ---- Build chunk corpus + BM25 IDF --------------------------------------
# Content comes from the RDF graph `g` (Cell 11), not NetworkX `G` --
# G only carries content if Cell 12's DOC_QUERY type filter matched,
# whereas ex:documentContent in `g` is always populated.
DOC_Q = PREFIXES + """
SELECT ?doc ?label ?ref ?content
WHERE {
    ?doc ex:documentContent ?content .
    OPTIONAL { ?doc rdfs:label         ?label }
    OPTIONAL { ?doc ex:sourceReference ?ref }
}
"""

CORPUS, DF = [], Counter()
DOC_TEXT = {}                              # doc_uri -> (title, ref, content)

for row in g.query(DOC_Q):
    uri = str(row.doc)
    title = str(row.label) if row.label else NODE_LABEL.get(uri, uri)
    ref = str(row.ref) if row.ref else uri
    content = clean(str(row.content))
    DOC_TEXT[uri] = (title, ref, content)

    for ch in split_chunks(content):
        tf = Counter(toks(ch))
        if not tf:
            continue
        CORPUS.append({"content": ch, "title": title, "reference": ref,
                       "doc_uri": uri, "tf": tf, "len": sum(tf.values())})
        for w in tf:
            DF[w] += 1

Nc = max(1, len(CORPUS))
AVG = sum(c["len"] for c in CORPUS) / Nc
IDF = {w: math.log(1 + (Nc - df + 0.5) / (df + 0.5)) for w, df in DF.items()}
print(f"Corpus: {Nc} chunks | vocab {len(DF)}  (returning top {TOP_K})")

q_terms = tset(QUERY_KG)


def bm25(tf, ln, k1=1.2, b=0.75):
    s = 0.0
    for w in q_terms:
        f = tf.get(w, 0)
        if f:
            s += IDF.get(w, 0) * (f * (k1 + 1)) / (f + k1 * (1 - b + b * ln / AVG))
    return s


# ---- BM25 seeds -> BFS hops -> scope (the graph gate) -------------------
seed_scores = {}
for uri, (title, ref, content) in DOC_TEXT.items():
    t_tok = tset(title)
    c_tok = tset(content[:8000])
    s = 3 * sum(IDF.get(w, 0) for w in q_terms if w in t_tok) \
        + sum(IDF.get(w, 0) for w in q_terms if w in c_tok)
    if s > 0:
        seed_scores[uri] = s

seeds = [u for u, _ in sorted(seed_scores.items(), key=lambda x: x[1],
                              reverse=True)[:N_SEEDS]]


def neighbours(node):
    if node not in G:
        return set()
    return set(G.successors(node)) | set(G.predecessors(node))


hops = {s: 0 for s in seeds}
frontier = set(seeds)
for hop in range(1, MAX_HOP + 1):
    nxt = set()
    for cur in frontier:
        for nb in neighbours(cur):
            if nb not in hops:
                hops[nb] = hop
                nxt.add(nb)
    frontier = nxt

scope = set(hops)
print(f"Seeds {len(seeds)} -> scope {len(scope)} docs within {MAX_HOP} hops\n")

# ---- Rank chunks WITHIN scope only --------------------------------------
scored = []
for c in CORPUS:
    if c["doc_uri"] not in scope:          # graph gate: hard filter
        continue
    b = bm25(c["tf"], c["len"])
    if b <= 0:
        continue
    hop = hops[c["doc_uri"]]
    b += (MAX_HOP - min(hop, MAX_HOP)) * 0.5      # small closeness nudge
    scored.append({"content": c["content"], "title": c["title"],
                   "reference": c["reference"], "doc_uri": c["doc_uri"],
                   "_score": round(b, 2), "_hop": hop})

scored.sort(key=lambda x: x["_score"], reverse=True)

# ---- Dedup + per-doc cap -> top K ---------------------------------------
# Exact hashing misses near-duplicates produced by the chunk stride;
# shingle Jaccard catches passages that merely overlap heavily.
chosen, seen_h, seen_sh, per_doc = [], set(), [], defaultdict(int)
for c in scored:
    if len(chosen) >= TOP_K:
        break
    if per_doc[c["reference"]] >= MAX_PER_DOC:
        continue
    h = hashlib.md5(c["content"].encode()).hexdigest()
    if h in seen_h:
        continue
    sh = shingles(c["content"])
    if sh and any(len(sh & p) / len(sh | p) > JACCARD for p in seen_sh):
        continue
    chosen.append(c)
    seen_h.add(h)
    seen_sh.append(sh)
    per_doc[c["reference"]] += 1

# ---- Response payload (content, title, reference — NO LLM) --------------
response_kg = {
    "predictions": [{
        "data": [
            {"content": c["content"], "title": c["title"], "reference": c["reference"]}
            for c in chosen
        ]
    }]
}

print("Response KG:")
print(json.dumps(response_kg, indent=2, ensure_ascii=False))
