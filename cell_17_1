import re
MAX_CHARS_PER_DOC = 1500

SYSTEM_PROMPT = """You are an expert technical assistant.
CRITICAL RULES:
1. Answer ONLY using the retrieved Knowledge Graph context below. Do NOT use outside knowledge.
2. If both GRAPH RELATIONSHIPS and RAW DOCUMENT TEXT are empty, reply exactly: "The information is unavailable in the Knowledge Graph."
3. If context is present, synthesize a detailed answer from the relationships and text available.
4. Make logical inferences from the edges (e.g. if A 'depends on' B, explain how they relate)."""

def clean_title(raw_title):
    t = str(raw_title)
    if "doc:" in t or "WebHome" in t or "Temp_Import" in t:
        t = t.split(".")[-1].replace("WebHome", "").strip()
        t = re.sub(r'[^a-zA-Z0-9\s]', ' ', t).strip() or "an external document"
    return t

def generate_answer(USER_QUERY):
    """Cell 16 -> 17 -> LLM. Returns the answer string."""
    candidates, retrieved_edges = retrieve_docs(USER_QUERY)

    node_texts = [
        f"DOCUMENT TITLE: {c['title']}\nREFERENCE: {c['reference']}\nCONTENT:\n{(c['content'] or '')[:MAX_CHARS_PER_DOC]}"
        for c in candidates
    ]
    FULL_NODE_CONTEXT = "\n\n".join(node_texts)

    edge_lines = []
    for idx, (u, v, attr) in enumerate(retrieved_edges, 1):
        src = clean_title(KG.nodes[u].get("title", u))
        tgt = clean_title(KG.nodes[v].get("title", v))
        pred = str(attr.get("predicate", "related to")).replace("_", " ")
        edge_lines.append(f"{idx}. {src} {pred} {tgt}.")
    GRAPH_EDGE_CONTEXT = "\n".join(edge_lines)

    FINAL_PROMPT = f"Question:\n{USER_QUERY}\n---\nRAW DOCUMENT TEXT:\n{FULL_NODE_CONTEXT}\n---\nGRAPH RELATIONSHIPS:\n{GRAPH_EDGE_CONTEXT}"
    try:
        return llm.invoke([("system", SYSTEM_PROMPT), ("human", FINAL_PROMPT)]).content.strip()
    except Exception as e:
        return f"Error calling LLM: {e}"

