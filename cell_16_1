# ==========================================================
# Cell 16 : Graph-Scoped BM25 Retriever (documents)
#   BM25 seeds -> BFS max-hop 2 -> BM25 ranks docs WITHIN the 2-hop set
#   Output: candidates (top-10 docs) + retrieved_edges (for Cell 17)
# ==========================================================
import re, math
from collections import Counter

print("="*80); print("GRAPH-SCOPED BM25 RETRIEVER (docs)"); print("="*80)

USER_QUERY = "How can a new Test Environment be created in the application?"
TOP_K   = 10          # return 10 docs (top-K, K=10)
N_SEEDS = 5
MAX_HOP = 2

print(f"User Query: {USER_QUERY}\n")

def toks(t): return re.findall(r'[a-z0-9]+', str(t).lower())
def tset(t): return set(toks(t))

# --- BM25 IDF over documents (title + content) ---
DF, DOCS = Counter(), []
for n, a in KG.nodes(data=True):
    if not a.get("content"): continue
    terms = tset((a.get("title","") or "") + " " + (a.get("content","") or ""))
    DOCS.append((n, a, Counter(toks((a.get("title","") or "")+" "+(a.get("content","") or ""))), len(terms)))
    for w in set(terms): DF[w] += 1

Nd  = max(1, len(DOCS))
IDF = {w: math.log(1 + (Nd - df + 0.5)/(df + 0.5)) for w, df in DF.items()}
AVG = sum(d[3] for d in DOCS)/Nd

q_terms = tset(USER_QUERY)

def bm25(tf, ln, k1=1.5, b=0.75):
    s = 0.0
    for w in q_terms:
        f = tf.get(w, 0)
        if f: s += IDF.get(w,0)*(f*(k1+1))/(f + k1*(1 - b + b*ln/AVG))
    return s

# --- 1. BM25 seeds (title weighted) ---
seed_scores = {}
for n, a, tf, ln in DOCS:
    t_tok = tset(a.get("title","") or "")
    s = 3*sum(IDF.get(w,0) for w in q_terms if w in t_tok) + bm25(tf, ln)
    if s > 0: seed_scores[n] = s

seeds = [n for n,_ in sorted(seed_scores.items(), key=lambda x:x[1], reverse=True)[:N_SEEDS]]
print(f"Seeds: {len(seeds)}")
for n in seeds: print(f"  - {KG.nodes[n].get('title', n)}  (seed={seed_scores[n]:.2f})")

# --- 2. Graph traversal: BFS max-hop 2, both directions -> scope ---
def neighbours(node): return set(KG.successors(node)) | set(KG.predecessors(node))

hops = {s: 0 for s in seeds}
frontier = set(seeds)

for hop in range(1, MAX_HOP+1):
    nxt = set()
    for cur in frontier:
        for nb in neighbours(cur):
            if nb not in hops:
                hops[nb] = hop; nxt.add(nb)
    frontier = nxt

scope = set(hops)

# --- 2b. Edges: induced subgraph of scope ---
# Collects EVERY edge with both endpoints in scope, including edges between
# two hop-2 nodes. Works for DiGraph and MultiDiGraph, and keeps ALL parallel
# RDF predicates instead of only the first one.
retrieved_edges = [(u, v, d) for u, v, d in KG.subgraph(scope).edges(data=True)]

print(f"\nScope: {len(scope)} docs within {MAX_HOP} hops | {len(retrieved_edges)} edges")

# --- 3. BM25 rank docs WITHIN scope only ---
scored = []
for n, a, tf, ln in DOCS:
    if n not in scope: continue          # graph gate: only reachable docs
    score = bm25(tf, ln) + (MAX_HOP - min(hops[n], MAX_HOP))  # small closeness nudge
    if score > 0:
        scored.append((n, a, round(score, 3)))

scored.sort(key=lambda x: x[2], reverse=True)

candidates = [{
    "doc_id": n, "title": a.get("title", n), "reference": n,
    "content": a.get("content",""), "hop": hops.get(n, 99), "score": s,
} for n, a, s in scored[:TOP_K]]

# --- 4. Display ---
print("\n" + "="*80); print(f"TOP {TOP_K} DOCUMENTS"); print("="*80)
if not candidates: print("No content-bearing docs in scope for this query.")
for r, c in enumerate(candidates, 1):
    print(f"{r:>2}. score={c['score']:6.2f} hop={c['hop']}  {c['title'][:55]}")



print(type(KG), "| edges:", len(retrieved_edges), "| scope:", len(scope), "/", KG.number_of_nodes())
